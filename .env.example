# Paths
TCM_MODELLING_ROOT=./tcm_modelling
VAJRA_DOCS_DIR=./docs
VAJRA_VECTOR_DIR=./vector_store/faiss_index
VAJRA_RUNTIME_DIR=./data/runtime
VAJRA_SQLITE_DB=./data/runtime/vajra_ops.sqlite

# Prediction API
VAJRA_PREDICTION_API_URL=http://127.0.0.1:8000
VAJRA_PREDICTION_BACKEND=local
VAJRA_PREDICTION_API_NAME=Vajra Prediction API
VAJRA_APP_VERSION=0.1.0
VAJRA_PREDICTION_TIMEOUT_SECONDS=90

# Triton mode; enable after parity baseline is frozen
VAJRA_TRITON_URL=127.0.0.1:8000
VAJRA_TRITON_MODEL_NAME=vajra_predictor
VAJRA_TRITON_MODEL_VERSION=

# Existing LLM/RAG settings. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


VAJRA_LLM_PROVIDER=vllm
VAJRA_LLM_BASE_URL=http://vajra-llm-predictor.inference.svc.cluster.local/v1
VAJRA_LLM_API_KEY=EMPTY
VAJRA_LLM_MODEL=vajra-llama
VAJRA_LLM_TIMEOUT_SECONDS=240
VAJRA_LLM_MAX_RETRIES=2
VAJRA_LLM_MAX_TOKENS=384